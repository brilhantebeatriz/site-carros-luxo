window.addEventListener('DOMContentLoaded', () => {
  document.body.classList.add('fade-in');

  const modelo = getQueryParam('modelo');
  const tituloCarro = document.getElementById('tituloCarro');
  const imagemCarro = document.getElementById('imagemCarro');
  const descricaoCarro = document.getElementById('descricaoCarro');

  if (modelo && carros[modelo]) {
    modeloAtual = modelo;
    tituloCarro.innerText = carros[modelo].titulo;
    imagemCarro.src = carros[modelo].imagem;
    imagemCarro.alt = carros[modelo].titulo;

    const textoDiv = descricaoCarro.querySelector('.textoDescricao');
    if (textoDiv) {
      textoDiv.innerHTML = carros[modelo].descricao;
    }
  } else {
    tituloCarro.innerText = 'Carro não encontrado';
    imagemCarro.src = '';
    const textoDiv = descricaoCarro.querySelector('.textoDescricao');
    if (textoDiv) {
      textoDiv.innerText = 'Por favor, volte e escolha um carro válido.';
    }
  }
});


// CPF
function formatarCPF(input) {
  let numeros = input.value.replace(/\D/g, '');

  if (numeros.length > 11) {
    numeros = numeros.slice(0, 11);
  }

  let formatado = '';

  if (numeros.length > 0) {
    formatado += numeros.substring(0, 3);
  }
  if (numeros.length >= 4) {
    formatado += '.' + numeros.substring(3, 6);
  }
  if (numeros.length >= 7) {
    formatado += '.' + numeros.substring(6, 9);
  }
  if (numeros.length >= 10) {
    formatado += '-' + numeros.substring(9, 11);
  }

  input.value = formatado;
  verificarCampos(); // Chama verificação ao digitar o CPF
}



// telefone 
function limitarTelefone(input) {
  let numeros = input.value.replace(/\D/g, '');

  if (numeros.length > 11) {
    numeros = numeros.slice(0, 11);
  }

  let formatado = '';

  if (numeros.length > 0) {
    formatado += '(' + numeros.substring(0, 2);
  }
  if (numeros.length >= 3) {
    formatado += ') ' + numeros.substring(2, 7);
  }
  if (numeros.length >= 8) {
    formatado += '-' + numeros.substring(7, 11);
  }

  input.value = formatado;
  verificarCampos(); // Chama verificação ao digitar o telefone
}

function verificarCampos() {
  const inputs = document.querySelectorAll('.formularioContato input[type="text"], .formularioContato input[type="tel"], .formularioContato input[type="email"]');
  const radios = document.querySelectorAll('.botoesTratamento input[type="radio"]');
  const radioSelecionado = Array.from(radios).some(radio => radio.checked);

  // Captura valores individuais
  const telefone = document.querySelector('input[type="tel"]').value.replace(/\D/g, '');
  const cpf = document.getElementById('cpf').value.replace(/\D/g, '');
  const email = document.querySelector('input[type="email"]').value.trim();

  // Verificações personalizadas
  const telefoneValido = telefone.length === 11;
  const cpfValido = cpf.length === 11;
  const emailValido = email.endsWith('@gmail.com');

  const inputsPreenchidos = Array.from(inputs).every(input => input.value.trim() !== "");

  const botao = document.getElementById('botaoSolicitar');

  if (inputsPreenchidos && radioSelecionado && telefoneValido && cpfValido && emailValido) {
    botao.style.opacity = "1";
    botao.disabled = false;
  } else {
    botao.style.opacity = "0";
    botao.disabled = true;
  }
}





// botao pra aparecer dps de clicar no botao de solicitar compra

document.addEventListener("DOMContentLoaded", function () {
  const botaoSolicitar = document.getElementById("botaoSolicitar");
  if (botaoSolicitar) {
    botaoSolicitar.addEventListener("click", function () {
      const overlay = document.getElementById("overlayExclusivo");
      overlay.classList.add("ativo");
    });
  }

  const botaoRetornar = document.querySelector(".botao-retornar");
  if (botaoRetornar) {
    botaoRetornar.addEventListener("click", function () {
      const overlay = document.getElementById("overlayExclusivo");
      overlay.classList.remove("ativo");

      setTimeout(() => {
        window.location.href = "siteCompras.html";
      }, 300); // espera a animação de desaparecer (opcional)
    });
  }
});
