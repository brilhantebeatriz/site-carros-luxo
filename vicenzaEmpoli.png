sobreNos.css

body {
      margin: 0;
      background-color: #000;
      color: #fff;
      font-family: Arial, sans-serif;
    }

    header {
      display: flex;
      align-items: center;
      padding: 20px;
    }

    header img {
      width: 60px;
      height: auto;
      margin-right: 20px;
    }

    header h1 {
      font-size: 32px;
      color: #fff;
    }

    .imagemPrincipal {
      display: flex;
      justify-content: center;
      margin: 40px 0;
    }

    .imagemPrincipal img {
      max-width: 20%;
      height: 20%;
    }

    .text-section {
      padding: 0 20px;
      text-align: center;
      font-size: 18px;
      margin-bottom: 60px;
    }

    .team-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 40px;
      margin-bottom: 60px;
    }

    .team-member {
      display: flex;
      align-items: center;
      gap: 20px;
      max-width: 600px;
    }

    .team-member img {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      border: 3px solid gold;
      object-fit: cover;
    }

    .team-member p {
      color: #ccc;
      font-size: 16px;
      margin: 0;
    }

    .team-section {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 40px;
  gap: 30px;
}

.team-member {
  display: flex;
  align-items: flex-start;
  gap: 20px;
  max-width: 800px;
}

.team-member img {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  border: 3px solid gold;
  object-fit: cover;
}

.member-info {
  display: flex;
  flex-direction: column;
}

.member-info h3 {
  margin: 0 0 8px 0;
  font-size: 20px;
  color: #fff;
}

.member-info p {
  color: #ccc;
  font-size: 16px;
  margin: 0;
  text-align: left;
}
.insta-link{
    color: #e1306c;
    margin-right:8px;
    text-decoration: none;
    transition:color 0,3s;
}
.we-section h1 {
  text-align: center;
}
.text-section p {
  text-align: justify;
}
header h1 {
  border-bottom: 2px solid gold;
  padding-bottom: 5px;
  width: 100%;
  box-sizing: border-box;
}
header h1,
.we-section h1 {
  font-family: 'Playfair Display', serif;
  font-weight: 700; /* negrito */
}
.text-section p,
.team-member p {
  font-family: 'Open Sans', sans-serif;
  font-weight: 400;
  font-size: 16px; /* você pode ajustar o tamanho se quiser */
  line-height: 1.6; /* para dar mais espaço entre linhas e facilitar a leitura */
  text-align: justify; /* se quiser o texto justificado, como pediu antes */
}